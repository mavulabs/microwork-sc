{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["hardhat/types", "mocha", "chai"]
  },
  "include": ["test/**/*", "scripts/**/*"],
  "exclude": ["node_modules"]
}
